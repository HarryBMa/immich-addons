# Development stack only. Copy to deploy/dev/.env. Never point any of this at the family server.
#
# The hub container reads these too (env_file: .env in the compose file), which is why the Immich
# and DB settings appear here rather than in the repo-root .env.

# --- images ---------------------------------------------------------------------------------
DEV_IMMICH_TAG=release
DEV_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3

# --- exposure -------------------------------------------------------------------------------
# Loopback by default. Widen to a LAN address only if you need to reach the dev stack from
# another machine, and never to 0.0.0.0 on a host that also serves the family instance.
DEV_BIND=127.0.0.1
DEV_IMMICH_PORT=2284
DEV_HUB_PORT=8485
DEV_DB_PORT=5433

# --- dev database ---------------------------------------------------------------------------
DEV_DB_USER=immich
DEV_DB_PASSWORD=devonly
DEV_DB_NAME=immich

# --- hub ------------------------------------------------------------------------------------
IMMICH_API_KEY=            # create in the dev Immich UI after first login
IMMICH_VERSION=
IMMICH_DB_NAME=immich
IMMICH_DB_USER=addons_ro
IMMICH_DB_PASSWORD=devonly-readonly    # matches init-readonly-role.sql
HUB_PASSWORD=dev
HUB_WEBHOOK_TOKEN=devtoken
DATA_DIR=/data
TRIGGER_MODE=poll
DRY_RUN_DEFAULT=true
